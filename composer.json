{
    "name": "carsdotcom/laravel-json-schema",
    "type": "library",
    "description": "Json Schema validation for Laravel projects",
    "keywords": [
        "library",
        "jsonschema",
        "laravel",
        "validation"
    ],
    "license": "MIT",
    "require": {
        "laravel/framework": "^12.0 || ^13.0",
        "opis/json-schema": "^2.3",
        "php": "^8.2"
    },
    "require-dev": {
        "myclabs/php-enum": "^1.8",
        "orchestra/testbench": "10.*|11.*",
        "phpunit/phpunit": "^11.5.3|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Carsdotcom\\JsonSchemaValidation\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\": "database/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Carsdotcom\\JsonSchemaValidation\\SchemaValidatorProvider"
            ],
            "aliases": {
                "SchemaValidator": "Carsdotcom\\JsonSchemaValidation\\SchemaValidator"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
